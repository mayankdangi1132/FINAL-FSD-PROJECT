              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('orderId', d.order.id);",
                  "pm.collectionVariables.set('orderToken', d.accessToken);",
                  "pm.test('order placed', () => pm.expect(d.order.status).to.eql('placed'));"
                ]
              }
            }
          ]
        },
