    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderToken",
      "value": ""
    },
    {
      "key": "menuItemId",
      "value": ""
    },
    {
      "key": "tomorrow",
      "value": ""
