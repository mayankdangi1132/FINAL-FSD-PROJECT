  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const t = new Date(Date.now() + 86400000);",
          "const pad = (n) => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('tomorrow', `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`);"
        ]
      }
    }
  ]
