              "mode": "raw",
              "raw": "{\n  \"type\": \"pickup\",\n  \"customer\": {\n    \"name\": \"Guest User\",\n    \"phone\": \"98111 00000\",\n    \"email\": \"guest@example.com\"\n  },\n  \"items\": [\n    {\n      \"itemId\": \"{{menuItemId}}\",\n      \"qty\": 2,\n      \"selections\": {\n        \"Spice level\": \"Hot\"\n      }\n    }\n  ],\n  \"paymentMethod\": \"cash\",\n  \"promoCode\": \"WELCOME10\"\n}"
