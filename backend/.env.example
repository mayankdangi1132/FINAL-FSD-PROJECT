# Copy this file to .env and change what you need. Every value is optional for local use.

# Port the API listens on (5000 is avoided because macOS uses it for AirPlay)
PORT=5050

# Where the React app runs (used for CORS and Stripe redirects)
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB connection string.
# Leave EMPTY to use the built-in local MongoDB (no install needed; data saved in backend/.data).
# Examples:
#   MONGO_URI=mongodb://127.0.0.1:27017/saffron_table
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saffron_table
MONGO_URI=

# Optional — Cloudinary for menu photos. If empty, uploads are saved to backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Stripe TEST secret key (sk_test_...). If empty, card/UPI payments are simulated.
STRIPE_SECRET_KEY=
